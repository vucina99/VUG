# ==========================================================
# VUG — Apache konfiguracija
# ==========================================================

# Default dokument
DirectoryIndex index.php index.html

# Bez listanja direktorijuma.
# -MultiViews je OBAVEZAN: sa uključenim MultiViews Apache sam mapira
# /projekti/<slug> na projekti.php (+ PATH_INFO) PRE mod_rewrite pravila,
# pa stranica pojedinačnog projekta nikad ne bi bila pozvana.
Options -Indexes -MultiViews

# UTF-8 default
AddDefaultCharset UTF-8

# Brendirana 404 stranica (pravi HTTP 404 status, ne soft-404)
ErrorDocument 404 /404.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # ======================================================
    # KANONIKALIZACIJA DOMENA (samo produkcija vugagency.com)
    # Cilj: jedna kanonska verzija -> https://vugagency.com
    # Uslovi su vezani za produkcijski host, pa lokal (localhost)
    # i dev okruženja ostaju netaknuta (rade preko http-a).
    # Svako pravilo je JEDAN hop (bez redirect lanaca / petlji).
    # %{REQUEST_URI} čuva putanju; query string Apache dodaje sam.
    # ======================================================

    # 1) www.* (http ILI https) -> https://vugagency.com  (jedan skok)
    RewriteCond %{HTTP_HOST} ^www\.vugagency\.com$ [NC]
    RewriteRule ^ https://vugagency.com%{REQUEST_URI} [R=301,L]

    # 2) http://vugagency.com -> https://vugagency.com
    #    (uzima u obzir i reverse-proxy preko X-Forwarded-Proto)
    RewriteCond %{HTTP_HOST} ^vugagency\.com$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://vugagency.com%{REQUEST_URI} [R=301,L]

    # ------------------------------------------------------
    # Cist URL za jezik: /en -> index.php?lang=en (srpski ostaje na /)
    # Radi i u podfolderu (lokal) i u rootu (produkcija).
    # ------------------------------------------------------
    RewriteRule ^en/?$ index.php?lang=en [L,QSA]

    # ------------------------------------------------------
    # Portfolio — PRIVREMENO ISKLJUČEN (2026-09-23, pred izlazak na produkciju).
    # Sadržaj je demo, pa stranice ne smeju da postoje ni za posetioca ni za
    # Google: sve rute vraćaju pravi 404, kao i direktan pristup .php fajlovima.
    # NAMERNO bez Disallow u robots.txt — zabrana puzanja bi sprečila Google da
    # uopšte vidi 404, pa bi URL-ovi duže ostali u indeksu.
    # Fajlovi (projekti.php, projekat.php, php/projects.php, img/projects/) NISU
    # obrisani. Vraćanje portfolija = obrisati tri 404 pravila ispod, odkomentarisati
    # rute, vratiti stavku u partials/header.php i footer.php i dodati URL-ove u
    # sitemap.xml (uz $GLOBALS['VUG_PROJECTS_DEMO'] = false u php/projects.php).
    #
    #   RewriteRule ^en/projects/?$ projekti.php?lang=en [L,QSA]
    #   RewriteRule ^projekti/?$    projekti.php [L,QSA]
    #   RewriteRule ^en/projects/([a-z0-9-]+)/?$ projekat.php?slug=$1&lang=en [L,QSA]
    #   RewriteRule ^projekti/([a-z0-9-]+)/?$    projekat.php?slug=$1 [L,QSA]
    # ------------------------------------------------------
    RewriteRule ^en/projects(/|$)          - [R=404,L]
    RewriteRule ^projekti(/|$)             - [R=404,L]
    RewriteRule ^(projekti|projekat)\.php$ - [R=404,L]

    # Lokalne landing stranice (izrada web sajta po gradovima) -> landing.php
    # EN varijante prvo (specifičnije rute), pa SR.
    RewriteRule ^en/izrada-web-sajta-pancevo/?$ landing.php?loc=pancevo&lang=en [L,QSA]
    RewriteRule ^en/izrada-web-sajta-beograd/?$ landing.php?loc=beograd&lang=en [L,QSA]
    RewriteRule ^izrada-web-sajta-pancevo/?$    landing.php?loc=pancevo [L,QSA]
    RewriteRule ^izrada-web-sajta-beograd/?$    landing.php?loc=beograd [L,QSA]

    # Vođenje društvenih mreža po gradovima -> landing.php (svc=social)
    RewriteRule ^en/vodjenje-drustvenih-mreza-pancevo/?$ landing.php?svc=social&loc=pancevo&lang=en [L,QSA]
    RewriteRule ^en/vodjenje-drustvenih-mreza-beograd/?$ landing.php?svc=social&loc=beograd&lang=en [L,QSA]
    RewriteRule ^vodjenje-drustvenih-mreza-pancevo/?$     landing.php?svc=social&loc=pancevo [L,QSA]
    RewriteRule ^vodjenje-drustvenih-mreza-beograd/?$     landing.php?svc=social&loc=beograd [L,QSA]

    # Pravne stranice (cisti URL-ovi) -> legal.php
    RewriteRule ^politika-privatnosti/?$ legal.php?doc=privacy [L,QSA]
    RewriteRule ^uslovi-koriscenja/?$    legal.php?doc=terms   [L,QSA]
    RewriteRule ^politika-kolacica/?$    legal.php?doc=cookies [L,QSA]
</IfModule>

# ==========================================================
# MIME tipovi
# ==========================================================
<IfModule mod_mime.c>
    AddType font/woff2 .woff2
    AddType image/svg+xml .svg
    AddType application/manifest+json .webmanifest
</IfModule>

# ==========================================================
# Zastita osetljivih fajlova
# ==========================================================
<FilesMatch "^\.(htaccess|env|gitignore)$">
    Require all denied
</FilesMatch>

# ==========================================================
# Security headers
# ==========================================================
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()"

    # HSTS — SAMO na HTTPS odgovoru (env=HTTPS). Bez includeSubDomains/preload
    # dok se ne potvrdi da SVI subdomeni (uklj. www) rade isključivo preko HTTPS-a.
    Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS

    # HTML se NE kešira dugo — korisnik uvek dobije svežu verziju stranice.
    <FilesMatch "\.(php|html)$">
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>

    # Verzionisani statički asseti (CSS/JS imaju ?v=; fontovi/slike su nepromenljivi)
    # -> dugoročni immutable cache.
    <FilesMatch "\.(css|js|woff2|woff|ttf|otf|png|jpe?g|webp|avif|gif|svg|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# ==========================================================
# Kompresija (Brotli ako postoji, u suprotnom Gzip)
# ==========================================================
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/javascript application/javascript application/json application/ld+json image/svg+xml application/xml
</IfModule>
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/ld+json image/svg+xml application/xml
</IfModule>

# ==========================================================
# Fallback cache (mod_expires) — ako mod_headers nije dostupan
# ==========================================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>
