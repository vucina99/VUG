# VUG — Apache config

# Default dokument
DirectoryIndex index.php index.html

# Bez listanja direktorijuma
Options -Indexes

# Cist URL za jezik: /en -> index.php?lang=en (srpski ostaje na /)
# Radi i u podfolderu (lokal) i u rootu (produkcija) jer je putanja relativna.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^en/?$ index.php?lang=en [L,QSA]
</IfModule>

# UTF-8 default
AddDefaultCharset UTF-8

# Zastita osetljivih fajlova
<FilesMatch "^\.(htaccess|env|gitignore)$">
    Require all denied
</FilesMatch>

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Gzip kompresija
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# Cache statika
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 6 months"
    ExpiresByType image/png "access plus 6 months"
    ExpiresByType image/jpeg "access plus 6 months"
    ExpiresByType image/webp "access plus 6 months"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>